{
  "name": "cloudfarm",
  "version": "0.1.0",
  "description": "Hand an agent a computer: a filesystem, a shell, apps and code mode, in one install",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cloudfarm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "@cloudfarm/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@cloudfarm/computer": "workspace:^",
    "@cloudfarm/qjs-engine": "workspace:^",
    "@cloudfarm/rbash-sandbox": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecloudfarm/computer.git",
    "directory": "packages/cloudfarm"
  },
  "homepage": "https://github.com/usecloudfarm/computer/tree/main/packages/cloudfarm#readme",
  "bugs": {
    "url": "https://github.com/usecloudfarm/computer/issues"
  }
}
