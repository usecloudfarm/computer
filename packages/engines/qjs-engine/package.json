{
  "name": "@cloudfarm/qjs-engine",
  "version": "0.0.1",
  "description": "Code mode for Computer: a QuickJS isolate that runs on Node and on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "@cloudfarm/source": "./src/workers.ts",
        "types": "./dist/workers.d.ts",
        "import": "./dist/workers.js"
      },
      "@cloudfarm/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./workers": {
      "@cloudfarm/source": "./src/workers.ts",
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./engine": {
      "@cloudfarm/source": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@cloudfarm/computer": "workspace:^",
    "@jitl/quickjs-wasmfile-release-asyncify": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "devDependencies": {
    "@cloudfarm/bash-sandbox": "workspace:^",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecloudfarm/computer.git",
    "directory": "packages/engines/qjs-engine"
  },
  "homepage": "https://github.com/usecloudfarm/computer/tree/main/packages/engines/qjs-engine#readme",
  "bugs": {
    "url": "https://github.com/usecloudfarm/computer/issues"
  }
}
