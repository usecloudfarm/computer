{
  "name": "@cloudfarm/firecrawl",
  "version": "0.0.1",
  "description": "Firecrawl as a Computer app: web search, scrape a page to markdown, map a site's links",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cloudfarm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@cloudfarm/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haxzie/unsandbox.git",
    "directory": "packages/integrations/firecrawl"
  },
  "homepage": "https://github.com/haxzie/unsandbox/tree/main/packages/integrations/firecrawl#readme",
  "bugs": {
    "url": "https://github.com/haxzie/unsandbox/issues"
  }
}
