{
  "name": "@cloudfarm/e2b-sandbox",
  "version": "0.0.1",
  "description": "SandboxProvider over E2B: firecracker microVMs for agent code",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cloudfarm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@cloudfarm/core": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "e2b": "^2.64.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "peerDependencies": {
    "e2b": "^2.64.0"
  },
  "peerDependenciesMeta": {
    "e2b": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecloudfarm/computer.git",
    "directory": "packages/sandboxes/e2b-sandbox"
  },
  "homepage": "https://github.com/usecloudfarm/computer/tree/main/packages/sandboxes/e2b-sandbox#readme",
  "bugs": {
    "url": "https://github.com/usecloudfarm/computer/issues"
  }
}
