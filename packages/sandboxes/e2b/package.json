{
  "name": "@cloudfarm/e2b",
  "version": "0.1.0",
  "private": true,
  "description": "SandboxProvider over E2B: firecracker microVMs for agent code",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cloudfarm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@cloudfarm/core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "e2b": "^2.64.0"
  },
  "peerDependencies": {
    "e2b": "^2.64.0"
  },
  "peerDependenciesMeta": {
    "e2b": {
      "optional": true
    }
  }
}
