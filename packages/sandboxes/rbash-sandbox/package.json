{
  "name": "@cloudfarm/rbash-sandbox",
  "version": "0.1.1",
  "description": "SandboxProvider over rust-bash: bash compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "@cloudfarm/source": "./src/workers.ts",
        "types": "./dist/workers.d.ts",
        "import": "./dist/workers.js"
      },
      "@cloudfarm/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./workers": {
      "@cloudfarm/source": "./src/workers.ts",
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./node": {
      "@cloudfarm/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo .wrangler *.tsbuildinfo"
  },
  "dependencies": {
    "@cloudfarm/computer": "workspace:^",
    "@cloudfarm/rbash": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
