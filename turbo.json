{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "server/**",
        "index.html",
        "tsconfig*.json",
        "tsup.config.ts",
        "vite.config.ts",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "package.json"],
      "outputs": []
    },
    "test:workers": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.workers.config.*", "wrangler.jsonc", "package.json"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "inputs": ["src/**", "server/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "server/**", "package.json"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [".oxlintrc.json", "tsconfig.base.json"]
}
