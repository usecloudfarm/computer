# Copy to .env and fill in what you need. `.env` is gitignored; this file is not.
#
# Loaded by `pnpm --filter @cloudfarm/web dev`, which reads this root file
# first and then apps/web/.env, so a value there overrides one here.

# --- required -----------------------------------------------------------
# The playground refuses to start without it.
ANTHROPIC_API_KEY=

# --- optional: apps that only appear when configured --------------------
# An app that cannot work is worse than an absent one — the model would find
# it with `search` and then fail on every call — so each is installed only
# when its credentials are present.

# Read the open web: firecrawl.dev
FIRECRAWL_API_KEY=

# Browser automation via Cloudflare Browser Rendering. Both are needed.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Slack. Used by examples/node-agent, not by the playground.
SLACK_TOKEN=

# --- optional: overrides -------------------------------------------------
# CLOUDFARM_MODEL=claude-sonnet-5-5
# PORT=8787
# Where the Vite dev server proxies /api. Defaults to http://localhost:8787.
# CLOUDFARM_API=http://localhost:8787

# Workspace storage: any S3-compatible bucket. With these set the workspace
# filesystem is durable; without them it is in memory and dies with the
# process. The shell sees it at /data either way.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cloudfarm
