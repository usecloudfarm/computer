{
  "name": "@cloudfarm/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A chat UI for driving a Computer, with every tool call visible",
  "scripts": {
    "dev": "turbo run build --filter=@cloudfarm/web^... && node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/react": "^4.0.183",
    "@cloudfarm/ai-sdk-toolset": "workspace:^",
    "@cloudfarm/bash-sandbox": "workspace:^",
    "@cloudfarm/cloudflare-browser": "workspace:^",
    "@cloudfarm/core": "workspace:^",
    "@cloudfarm/firecrawl": "workspace:^",
    "@cloudfarm/hackernews": "workspace:^",
    "@cloudfarm/qjs-engine": "workspace:^",
    "@cloudfarm/slack": "workspace:^",
    "@hono/node-server": "^1.15.0",
    "@pierre/highlights": "^0.5.1",
    "@pierre/words": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "ai": "^7.0.179",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "hono": "^4.6.0",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
