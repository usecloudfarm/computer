# Copy to .env (gitignored) to run the playground.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-sonnet-5-5
# CLOUDFARM_MODEL=claude-opus-5-5
# Optional: the API port the Vite dev server proxies to (default 8787)
# PORT=8787
# Optional: adds the `web` app (read any page as markdown, screenshot, scrape).
# The token needs the "Browser Run - Edit" permission.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
