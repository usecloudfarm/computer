{
  "name": "cloudfarm-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Computer \u2014 a fast computer with the right tools for every agent",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:workers": "turbo run test:workers",
    "test:watch": "turbo run test:watch",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "bench": "turbo run build --filter=@cloudfarm/computer --filter=@cloudfarm/bash-sandbox --filter=@cloudfarm/rbash-sandbox && node tools/shell-bench/bench.mjs",
    "gen:integrations": "node tools/integration-codegen/generate.mjs",
    "gen:integrations:check": "node tools/integration-codegen/generate.mjs --check",
    "lint:fix": "oxlint --fix",
    "check": "pnpm format:check && pnpm gen:integrations:check && pnpm lint && turbo run lint typecheck build test test:workers",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm check && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "turbo": "^2.11.12",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
