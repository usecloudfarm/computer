{
  "name": "@cloudfarm/example-node-agent",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "The brief's snippet, typechecked in CI and runnable against real services",
  "scripts": {
    "start": "turbo run build --filter=@cloudfarm/example-node-agent... && node --experimental-strip-types src/main.ts",
    "demo": "turbo run build --filter=@cloudfarm/example-node-agent... && node --experimental-strip-types src/demo.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf .turbo *.tsbuildinfo",
    "agent": "turbo run build --filter=@cloudfarm/example-node-agent... && node --env-file-if-exists=.env --experimental-strip-types src/agent.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@cloudfarm/ai-sdk-toolset": "workspace:^",
    "@cloudfarm/bash-sandbox": "workspace:^",
    "@cloudfarm/computer": "workspace:^",
    "@cloudfarm/firecrawl": "workspace:^",
    "@cloudfarm/qjs-engine": "workspace:^",
    "@cloudfarm/slack": "workspace:^",
    "ai": "^7.0.178"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
